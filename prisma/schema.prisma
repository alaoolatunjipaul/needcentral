// NeedCentral — Prisma schema (Project 5, extended for Project 6 auth)
//
// Project 5 scope: the core storefront catalogue is moved into PostgreSQL:
// Category, Seller and Product. Money is stored in minor currency units
// ("cents" / kobo) to match the existing TypeScript types (see types/index.ts).
//
// Project 6 scope: adds the authentication persistence foundation — User,
// Account and Session — while leaving the higher-fidelity/volume entities
// (reviews, Q&A, wishlist, orders, coupons, delivery / pickup config)
// intentionally client-side for now. The auth models follow the standard
// Auth.js-compatible shape and are wired to no UI / framework yet.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       String    @id
  name     String
  tagline  String
  products Product[]

  @@map("categories")
}

model Seller {
  id          String    @id
  name        String
  location    String
  description String
  joinedYear  Int
  products    Product[]

  @@map("sellers")
}

model Product {
  id                  String   @id
  name                String
  categoryId          String
  sellerId            String?
  priceCents          Int
  compareAtPriceCents Int?
  image               String
  description         String
  rating              Float
  reviewCount         Int
  stock               Int
  featured            Boolean  @default(false)

  // Origin (nullable) normalised from the flat `origin` object into scalars.
  originCountry     String?
  originCountryCode String?
  madeInAfrica      Boolean?

  // Optional per-star review counts, rendered only when present.
  ratingDistribution Json?

  category Category @relation(fields: [categoryId], references: [id])
  seller   Seller?  @relation(fields: [sellerId], references: [id])

  // Storefront query patterns (filterAndSortProducts equivalents).
  @@index([categoryId])
  @@index([sellerId])
  @@index([featured])
  @@index([categoryId, priceCents])

  @@map("products")
}

// Authentication (Project 6)
//
// Minimal, framework-agnostic auth persistence following the standard
// Auth.js-compatible shape so a real provider can be layered on later:
//   - User      core identity (nullable passwordHash reserved for an
//               email/password strategy; OAuth flows use Account instead).
//   - Account   OAuth / third-party provider credentials per user.
//   - Session   server-side session tokens per user.
// These are NOT wired to any UI or auth framework yet.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
