// NeedCentral — Prisma schema (Projects 5–7)
//
// Project 5 scope: the core storefront catalogue is moved into PostgreSQL:
// Category, Seller and Product. Money is stored in minor currency units
// ("cents" / kobo) to match the existing TypeScript types (see types/index.ts).
//
// Project 6 scope: adds the authentication persistence foundation — User,
// Account and Session (server-side session cookie in lib/auth-service.ts).
//
// Project 7 scope: order history moves out of per-device localStorage into
// PostgreSQL — Order + OrderItem are persisted scoped to the signed-in user.
// The remaining high-fidelity / volume entities (reviews, Q&A, wishlist,
// coupons, delivery / pickup config) stay intentionally client-side for now.
//
// Stage #5 scope: enforced buyer protection, returns and shipping logistics.
// Adds additive fulfillment metadata to Order (static tracking number +
// shippedAt / deliveredAt), an OrderEvent audit trail, and an OrderReturn
// lifecycle that ends in a "Refund Pending Manual" state — refunds are recorded,
// never auto-initiated this stage. No carrier integration; no seller dashboard.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       String    @id
  name     String
  tagline  String
  products Product[]

  @@map("categories")
}

model Seller {
  id          String    @id
  name        String
  location    String
  description String
  joinedYear  Int
  products    Product[]

  @@map("sellers")
}

model Product {
  id                  String   @id
  name                String
  categoryId          String
  sellerId            String?
  priceCents          Int
  compareAtPriceCents Int?
  image               String
  description         String
  rating              Float
  reviewCount         Int
  stock               Int
  featured            Boolean  @default(false)

  // Origin (nullable) normalised from the flat `origin` object into scalars.
  originCountry     String?
  originCountryCode String?
  madeInAfrica      Boolean?

  // Optional per-star review counts, rendered only when present.
  ratingDistribution Json?

  category Category @relation(fields: [categoryId], references: [id])
  seller   Seller?  @relation(fields: [sellerId], references: [id])

  // Storefront query patterns (filterAndSortProducts equivalents).
  @@index([categoryId])
  @@index([sellerId])
  @@index([featured])
  @@index([categoryId, priceCents])

  @@map("products")
}

// Authentication (Project 6)
//
// Minimal, framework-agnostic auth persistence following the standard
// Auth.js-compatible shape so a real provider can be layered on later:
//   - User      core identity (nullable passwordHash reserved for an
//               email/password strategy; OAuth flows use Account instead).
//   - Account   OAuth / third-party provider credentials per user.
//   - Session   server-side session tokens per user.
// These are NOT wired to any UI or auth framework yet.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  returns       OrderReturn[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Order history (Project 7)
//
// Server-side persistence for the checkout's Order / OrderItem shapes (see
// types/index.ts). Orders are scoped to the signed-in user (userId → users,
// ON DELETE CASCADE). Freestanding objects (pickupStation, shippingAddress)
// and optional coupon metadata are stored as JSON / nullable columns. Money is
// stored in minor currency units ("cents" / kobo), matching the TS types.

model Order {
  id                  String     @id
  userId              String
  email               String
  items               OrderItem[]
  subtotalCents       Int
  shippingCents       Int
  totalCents          Int
  status              String
  deliveryOptionId    String
  crossBorder         Boolean    @default(false)
  pickupStation       Json?
  shippingAddress     Json?
  placedAtISO         DateTime
  estimatedDeliveryISO DateTime
  couponCode          String?
  couponDescription   String?
  discountCents       Int?

  // Payment gateway metadata (Payment Gateway Integration stage).
  // Set after server-side Paystack verification / webhook confirmation. An
  // order starts as "pending"; it is only marked paid (status -> "confirmed")
  // after the provider transaction is verified. Raw card / CVV data is never
  // stored — only the provider reference and gateway timestamp.
  paymentProvider    String?
  paymentReference   String?
  paidAt             DateTime?

  // Fulfillment metadata (Buyer protection / returns & shipping, stage #5).
  // Static NeedCentral-generated tracking number + shipment milestones.
  // Advancement is simulated through the buyer / order-owner flow this stage.
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  // Stage #5 audit trail (one OrderEvent row per lifecycle change).
  events  OrderEvent[]
  // Stage #5 returns lifecycle (request -> approved/rejected -> manual refund).
  returns OrderReturn[]

  createdAt           DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-user order listing (newest first) is the hot read path.
  @@index([userId, placedAtISO])
  // Webhook / verification lookups are keyed by the gateway reference.
  @@index([paymentReference])

  @@map("orders")
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productId  String
  name       String
  image      String
  priceCents Int
  quantity   Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Order lifecycle audit trail (stage #5). One immutable row per state change,
// mirroring the transition table enforced in lib/order-lifecycle.ts. Kept
// intentionally free-form (string eventType) so future stages can extend it
// without a migration.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  eventType String
  note      String?
  at        DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([eventType])
  @@map("order_events")
}

// Buyers' return requests (stage #5).
//
// Lifecycle:
//   requested  -> refund_pending_manual   (owner approves; refund is recorded,
//                                           NOT auto-initiated this stage)
//   requested  -> rejected                (owner rejects)
//   refund_pending_manual -> refunded     (manual completion, no provider call)
//
// Refunds are a manual, human-owned step this stage: an approved return sets
// status to "refund_pending_manual" and records refundCents; nothing calls the
// payment provider. Items are stored as a JSON snapshot (productId, name,
// priceCents, quantity) so history survives later catalog changes.
model OrderReturn {
  id             String   @id @default(cuid())
  orderId        String
  userId         String
  items          Json
  reason         String
  status         String   @default("requested")
  refundCents    Int?
  requestedAt    DateTime @default(now())
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectedReason String?
  refundedAt     DateTime?
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("order_returns")
}
